---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<BaseLayout title="The Telegraphic Developer — Tech Blog by Vladimír Oraný">
  <div class="container">
    <section class="hero">
      <h1>The Telegraphic Developer</h1>
      <p class="tagline">by Vladimír Oraný</p>
      <p class="intro">
        Groovy, Micronaut, Java, and developer tools — dispatches from the JVM trenches.
        Open source contributor, conference speaker, and newsletter author.
      </p>
      <div class="hero-links">
        <a href="https://telegraphic.substack.com" target="_blank" rel="noopener" class="hero-link">Newsletter</a>
        <a href="https://bsky.app/profile/telegraphic.dev" target="_blank" rel="noopener" class="hero-link">Bluesky</a>
        <a href="https://x.com/telegraphic_dev" target="_blank" rel="noopener" class="hero-link">X</a>
      </div>
    </section>

    <section class="recent-posts">
      <h2>Recent Articles</h2>
      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-card">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h3>
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
      <a href="/blog" class="view-all">View all articles →</a>
    </section>

    <section class="featured-projects">
      <h2>Featured Projects</h2>
      <div class="projects-grid">
        <div class="project-card">
          <h3>
            <a href="https://github.com/agorapulse/micronaut-aws-sdk" target="_blank" rel="noopener">
              micronaut-aws-sdk
            </a>
          </h3>
          <p>Micronaut libraries for AWS — DynamoDB, S3, SES, SNS, SQS and more</p>
          <span class="stars">⭐ 39</span>
        </div>
        <div class="project-card">
          <h3>
            <a href="https://github.com/agorapulse/micronaut-worker" target="_blank" rel="noopener">
              micronaut-worker
            </a>
          </h3>
          <p>Advanced scheduling and work distribution for Micronaut</p>
          <span class="stars">⭐ 9</span>
        </div>
        <div class="project-card">
          <h3>
            <a href="https://github.com/agorapulse/gru" target="_blank" rel="noopener">
              Gru
            </a>
          </h3>
          <p>HTTP interaction testing framework for Micronaut, Grails & Spring</p>
        </div>
      </div>
      <a href="/projects" class="view-all">View all projects →</a>
    </section>

    <section class="cta-section">
      <div class="cta-card">
        <h2>Got a problem? Let's build the solution.</h2>
        <p>
          Thanks to agentic development, custom apps are now affordable for everyone.
          Tell us what you need — apps start from $50.
        </p>
        <a href="https://ask.telegraphic.dev" class="cta-button" target="_blank" rel="noopener">
          Describe Your Problem →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .tagline {
    font-size: 1.5rem;
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    margin-bottom: 1.5rem;
  }

  .intro {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .hero-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .hero-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.4rem 1rem;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .hero-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  section {
    margin-top: 4rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .post-card {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .post-card:hover {
    border-color: var(--accent);
  }

  .post-card time {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
  }

  .post-card h3 {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag {
    background: var(--bg-tertiary);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
  }

  .view-all {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    margin-top: 1rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .project-card {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .project-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .stars {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--accent);
  }

  .cta-section {
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .cta-card {
    background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 3rem;
    text-align: center;
  }

  .cta-card h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .cta-card p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    max-width: 500px;
    margin: 0 auto 2rem;
  }

  .cta-button {
    display: inline-block;
    background: var(--accent);
    color: #0d1117;
    padding: 0.75rem 2rem;
    border-radius: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .cta-button:hover {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .hero h1 {
      font-size: 2rem;
    }

    .tagline {
      font-size: 1.2rem;
    }
  }
</style>
