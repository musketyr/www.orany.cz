---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Get unique tags
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))].sort();
---

<BaseLayout title="Blog - The Telegraphic Developer" description="Articles about Groovy, Micronaut, and software development">
  <div class="container">
    <header class="page-header">
      <h1>Blog</h1>
      <p>{sortedPosts.length} articles</p>
    </header>

    <div class="content-wrapper">
      <aside class="sidebar">
        <h3>Tags</h3>
        <div class="tag-list">
          {allTags.map((tag) => {
            const count = allPosts.filter(post => post.data.tags.includes(tag)).length;
            return (
              <a href={`/blog/tag/${tag}`} class="tag-link">
                {tag} <span class="count">({count})</span>
              </a>
            );
          })}
        </div>
      </aside>

      <main class="posts-main">
        <div class="post-list">
          {sortedPosts.map((post) => (
            <article class="post-card">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2>
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    margin: 0;
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 3rem;
    margin-top: 3rem;
  }

  .sidebar {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .sidebar h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tag-link {
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    transition: all 0.2s;
    font-size: 0.9rem;
  }

  .tag-link:hover {
    border-color: var(--accent);
    background: var(--bg-tertiary);
  }

  .tag-link .count {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-card {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .post-card:hover {
    border-color: var(--accent);
  }

  .post-card time {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
  }

  .post-card h2 {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag {
    background: var(--bg-tertiary);
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
      order: 2;
    }

    .posts-main {
      order: 1;
    }
  }
</style>
