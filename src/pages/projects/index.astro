---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Sorted by most recent activity within each category
const projects = {
  agorapulse: [
    { name: 'micronaut-aws-sdk', url: 'https://github.com/agorapulse/micronaut-aws-sdk', description: 'Micronaut libraries for AWS — DynamoDB, S3, SES, SNS, SQS and more', stars: 39, updated: '2026' },
    { name: 'micronaut-console', url: 'https://github.com/agorapulse/micronaut-console', description: 'Execute arbitrary code in running Micronaut apps', stars: null, updated: '2026' },
    { name: 'micronaut-worker', url: 'https://github.com/agorapulse/micronaut-worker', description: 'Advanced scheduling and work distribution for Micronaut', stars: 9, updated: '2025' },
    { name: 'micronaut-log4aws', url: 'https://github.com/agorapulse/micronaut-log4aws', description: 'Sentry integration for Micronaut Lambda on AWS', stars: null, updated: '2025' },
    { name: 'micronaut-newrelic', url: 'https://github.com/agorapulse/micronaut-newrelic', description: 'Send custom events to New Relic from Micronaut', stars: null, updated: '2025' },
    { name: 'micronaut-slack', url: 'https://github.com/agorapulse/micronaut-slack', description: 'Idiomatic Slack API integration for Micronaut', stars: null, updated: '2025' },
    { name: 'micronaut-snitch', url: 'https://github.com/agorapulse/micronaut-snitch', description: 'Track running async jobs (Quartz, Scheduled)', stars: null, updated: '2025' },
    { name: 'micronaut-segment', url: 'https://github.com/agorapulse/micronaut-segment', description: 'Segment analytics for Micronaut', stars: null, updated: '2025' },
    { name: 'micronaut-permissions', url: 'https://github.com/agorapulse/micronaut-permissions', description: 'Lightweight object-level permissions for Micronaut', stars: null, updated: '2025' },
  ],
  testing: [
    { name: 'Gru', url: 'https://github.com/agorapulse/gru', description: 'HTTP interaction testing framework for Micronaut & Spring', stars: null, updated: '2025' },
    { name: 'Fixt', url: 'https://github.com/agorapulse/fixt', description: 'Organize test fixtures in directories matching your test classes', stars: null, updated: null },
  ],
  saasApps: [
    { name: 'SheetRest', url: 'https://sheetrest.com', description: 'Turn Google Sheets into REST APIs instantly', stars: null, updated: '2025' },
    { name: 'Spreadsheet Builder', url: 'https://github.com/dsl-builders/spreadsheet', description: 'Create Excel spreadsheets with Groovy DSL or Java builders', stars: 25, updated: '2024' },
  ],
  dslBuilders: [
    { name: 'expectations', org: 'dsl-builders', url: 'https://github.com/dsl-builders/expectations', description: 'Expectations DSL builder for expressive assertions', stars: 2, updated: '2025' },
    { name: 'groovy-closure-support', org: 'dsl-builders', url: 'https://github.com/dsl-builders/groovy-closure-support', description: 'Groovy closure support for Java DSL builders', stars: 2, updated: '2023' },
  ],
};
---

<BaseLayout title="Projects - The Telegraphic Developer" description="Open source projects and contributions">
  <div class="container">
    <header class="page-header">
      <h1>Open Source Projects</h1>
      <p>Libraries, tools, and plugins for Micronaut and the JVM</p>
    </header>

    <section class="project-section">
      <h2>Agorapulse — Micronaut Libraries</h2>
      <div class="project-grid">
        {projects.agorapulse.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            <div class="card-meta">
              {project.stars && <span class="stars">⭐ {project.stars}</span>}
              {project.updated && <span class="updated">Updated {project.updated}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="project-section">
      <h2>Testing Libraries</h2>
      <div class="project-grid">
        {projects.testing.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            <div class="card-meta">
              {project.stars && <span class="stars">⭐ {project.stars}</span>}
              {project.updated && <span class="updated">Updated {project.updated}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="project-section">
      <h2>SaaS & Apps</h2>
      <div class="project-grid">
        {projects.saasApps.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            <div class="card-meta">
              {project.stars && <span class="stars">⭐ {project.stars}</span>}
              {project.updated && <span class="updated">Updated {project.updated}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="project-section">
      <h2>DSL Builders</h2>
      <div class="project-grid">
        {projects.dslBuilders.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            <div class="card-meta">
              {project.stars && <span class="stars">⭐ {project.stars}</span>}
              {project.updated && <span class="updated">Updated {project.updated}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin: 0;
  }

  .project-section {
    margin-top: 4rem;
  }

  .project-section h2 {
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .project-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .stars {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--accent);
  }

  .updated {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
</style>
