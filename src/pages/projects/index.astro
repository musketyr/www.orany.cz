---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = {
  personal: [
    { name: 'gradle-fatjar-plugin', url: 'https://github.com/musketyr/gradle-fatjar-plugin', description: 'Gradle FatJAR Plugin', stars: 180 },
    { name: 'bom-seed', url: 'https://github.com/musketyr/bom-seed', description: 'Seed project for creating BOMs', stars: 11 },
    { name: 'gpars-appengine', url: 'https://github.com/musketyr/gpars-appengine', description: 'GPars App Engine', stars: 8 },
    { name: 'duckapter', url: 'https://github.com/musketyr/duckapter', description: 'Duck-type adapter library for Groovy', stars: 8 },
    { name: 'wro4j-gradle-plugin', url: 'https://github.com/musketyr/wro4j-gradle-plugin', description: 'Gradle Wro4J Plugin', stars: 6 },
  ],
  dslBuilders: [
    { name: 'groovy-closure-support', org: 'dsl-builders', url: 'https://github.com/dsl-builders/groovy-closure-support', description: 'Groovy closure support for DSL builders', stars: 2 },
    { name: 'expectations', org: 'dsl-builders', url: 'https://github.com/dsl-builders/expectations', description: 'Expectations library for testing', stars: 2 },
  ],
  agorapulse: [
    { name: 'grails-aws-sdk', url: 'https://github.com/agorapulse/grails-aws-sdk', description: 'Amazon Web Services SDK Grails Plugin', stars: 59 },
    { name: 'micronaut-aws-sdk', url: 'https://github.com/agorapulse/micronaut-aws-sdk', description: 'Agorapulse AWS SDK for Micronaut', stars: 39 },
    { name: 'grails-facebook-sdk', url: 'https://github.com/agorapulse/grails-facebook-sdk', description: 'Facebook SDK Grails Plugin', stars: 30 },
    { name: 'micronaut-worker', url: 'https://github.com/agorapulse/micronaut-worker', description: 'Micronaut Worker - background job processing', stars: 9 },
    { name: 'micronaut-console', url: 'https://github.com/agorapulse/micronaut-console', description: 'Micronaut Console', stars: null },
    { name: 'micronaut-grails', url: 'https://github.com/agorapulse/micronaut-grails', description: 'Micronaut Grails integration', stars: null },
    { name: 'micronaut-log4aws', url: 'https://github.com/agorapulse/micronaut-log4aws', description: 'Micronaut Log4AWS', stars: null },
    { name: 'micronaut-permissions', url: 'https://github.com/agorapulse/micronaut-permissions', description: 'Micronaut Permissions', stars: null },
    { name: 'micronaut-slack', url: 'https://github.com/agorapulse/micronaut-slack', description: 'Micronaut Slack integration', stars: null },
    { name: 'micronaut-snitch', url: 'https://github.com/agorapulse/micronaut-snitch', description: 'Micronaut Snitch - monitoring', stars: null },
    { name: 'micronaut-newrelic', url: 'https://github.com/agorapulse/micronaut-newrelic', description: 'Micronaut New Relic integration', stars: null },
    { name: 'micronaut-segment', url: 'https://github.com/agorapulse/micronaut-segment', description: 'Micronaut Segment analytics', stars: null },
  ],
  testing: [
    { name: 'Dru', url: 'https://github.com/agorapulse/dru', description: 'Data Reconstruction Utility - test data management', stars: null },
    { name: 'Gru', url: 'https://github.com/agorapulse/gru', description: 'HTTP interaction testing framework', stars: null },
    { name: 'Fixt', url: 'https://github.com/agorapulse/fixt', description: 'Fixture organizer for tests', stars: null },
    { name: 'Office Unit', url: 'https://github.com/agorapulse/office-unit', description: 'MS Office document matching', stars: null },
  ],
};
---

<BaseLayout title="Projects - Vladimír Oraný" description="Open source projects and contributions">
  <div class="container">
    <header class="page-header">
      <h1>Open Source Projects</h1>
      <p>Libraries, tools, and plugins for Groovy, Grails, and Micronaut</p>
    </header>

    <section class="project-section">
      <h2>Personal Projects</h2>
      <div class="project-grid">
        {projects.personal.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            {project.stars && <span class="stars">⭐ {project.stars}</span>}
          </article>
        ))}
      </div>
    </section>

    <section class="project-section">
      <h2>DSL Builders</h2>
      <div class="project-grid">
        {projects.dslBuilders.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            {project.stars && <span class="stars">⭐ {project.stars}</span>}
          </article>
        ))}
      </div>
    </section>

    <section class="project-section">
      <h2>Agorapulse</h2>
      <div class="project-grid">
        {projects.agorapulse.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            {project.stars && <span class="stars">⭐ {project.stars}</span>}
          </article>
        ))}
      </div>
    </section>

    <section class="project-section">
      <h2>Testing Libraries</h2>
      <div class="project-grid">
        {projects.testing.map((project) => (
          <article class="project-card">
            <h3>
              <a href={project.url} target="_blank" rel="noopener">{project.name}</a>
            </h3>
            <p>{project.description}</p>
            {project.stars && <span class="stars">⭐ {project.stars}</span>}
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-header p {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin: 0;
  }

  .project-section {
    margin-top: 4rem;
  }

  .project-section h2 {
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .project-card h3 {
    margin-bottom: 0.75rem;
    font-size: 1.1rem;
  }

  .project-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .stars {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: var(--accent);
  }
</style>
